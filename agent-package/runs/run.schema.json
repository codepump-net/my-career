{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/agent-run.schema.json",
  "title": "Agent Run Evidence Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "timestamp", "stage", "version_tuple", "eval_or_request_ref", "status", "metrics", "approval_events", "failure_class", "evidence_uri", "data_handling"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9][A-Z0-9-]*$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "stage": { "enum": ["development", "fixed_eval", "replay", "shadow", "canary", "production"] },
    "version_tuple": { "$ref": "../evals/version-tuple.schema.json" },
    "eval_or_request_ref": { "type": "string", "minLength": 1 },
    "status": { "enum": ["success", "failure", "blocked", "cancelled"] },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "tool_calls", "retries", "input_tokens", "output_tokens", "cost_amount", "cost_currency"],
      "properties": {
        "latency_ms": { "type": "number", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cost_amount": { "type": "number", "minimum": 0 },
        "cost_currency": { "type": "string", "minLength": 1 }
      }
    },
    "approval_events": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "failure_class": { "type": ["string", "null"] },
    "evidence_uri": { "type": "string", "minLength": 1 },
    "data_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_sensitive_data", "trace_level", "retention_until", "redaction_verified"],
      "properties": {
        "contains_sensitive_data": { "type": "boolean" },
        "trace_level": { "enum": ["metadata", "redacted", "full_approved"] },
        "retention_until": { "type": ["string", "null"], "format": "date" },
        "redaction_verified": { "type": "boolean" }
      }
    }
  }
}
