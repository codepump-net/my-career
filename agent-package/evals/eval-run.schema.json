{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/agent-eval-run.schema.json",
  "title": "Agent Eval Run Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "eval_run_id", "started_at", "completed_at", "stage", "baseline", "candidate", "datasets", "graders", "execution", "summary", "critical_failures", "artifacts", "decision"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "eval_run_id": { "type": "string", "pattern": "^EVAL-[A-Z0-9][A-Z0-9-]*$" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "stage": { "enum": ["fixed_eval", "replay", "shadow", "canary"] },
    "baseline": { "$ref": "version-tuple.schema.json" },
    "candidate": { "$ref": "version-tuple.schema.json" },
    "datasets": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "graders": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetitions", "concurrency", "state_reset", "randomness_record"],
      "properties": {
        "repetitions": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "state_reset": { "enum": ["required", "not_applicable"] },
        "randomness_record": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "overall_pass_rate", "critical_pass_rate", "regression_count", "grader_disagreement_rate", "latency_p95_ms", "cost_per_task"],
      "properties": {
        "case_count": { "type": "integer", "minimum": 1 },
        "overall_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "critical_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "regression_count": { "type": "integer", "minimum": 0 },
        "grader_disagreement_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "latency_p95_ms": { "type": "number", "minimum": 0 },
        "cost_per_task": { "type": "number", "minimum": 0 }
      }
    },
    "critical_failures": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "decision": { "enum": ["pass", "conditional", "fail"] }
  }
}
