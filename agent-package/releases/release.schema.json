{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/agent-release.schema.json",
  "title": "Agent Release Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "agent_id", "agent_version", "change_id", "status", "release_date", "owner", "approver", "version_tuple", "gate_evidence", "eval_result_ref", "rollout", "rollback", "decision"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "release_id": { "type": "string", "pattern": "^RELEASE-[A-Z0-9][A-Z0-9-]*$" },
    "agent_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "agent_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "change_id": { "type": "string", "pattern": "^CHG-[A-Z0-9-]+$" },
    "status": { "enum": ["candidate", "active", "rejected", "rolled_back"] },
    "release_date": { "type": "string", "format": "date" },
    "owner": { "type": "string", "minLength": 1 },
    "approver": { "type": "string", "minLength": 1 },
    "version_tuple": { "$ref": "../evals/version-tuple.schema.json" },
    "gate_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A1", "A2", "A3", "A4"],
      "properties": {
        "A1": { "$ref": "gate.schema.json" },
        "A2": { "$ref": "gate.schema.json" },
        "A3": { "$ref": "gate.schema.json" },
        "A4": { "$ref": "gate.schema.json" }
      }
    },
    "eval_result_ref": { "type": "string", "minLength": 1 },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "scope", "duration", "success_criteria", "monitoring_ref"],
      "properties": {
        "stage": { "enum": ["fixed_eval", "replay", "shadow", "canary", "production"] },
        "scope": { "type": "string", "minLength": 1 },
        "duration": { "type": "string", "minLength": 1 },
        "success_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "monitoring_ref": { "type": "string", "minLength": 1 }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_known_good_release", "triggers", "procedure_ref", "rehearsal_evidence"],
      "properties": {
        "last_known_good_release": { "type": "string", "minLength": 1 },
        "triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "procedure_ref": { "type": "string", "minLength": 1 },
        "rehearsal_evidence": { "type": "string", "minLength": 1 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "rationale", "decided_at"],
      "properties": {
        "verdict": { "enum": ["release", "conditional", "reject", "roll_back"] },
        "rationale": { "type": "string", "minLength": 1 },
        "decided_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
