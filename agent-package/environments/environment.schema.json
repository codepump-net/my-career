{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/agent-environment.schema.json",
  "title": "Agent Execution Environment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "provider", "execution_mode", "sandbox", "network", "filesystem", "dependencies", "secrets", "limits", "state", "telemetry", "data", "approvals"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["proposed", "candidate", "active", "deprecated"] },
    "provider": { "enum": ["unbound", "openai", "anthropic", "local", "other"] },
    "execution_mode": { "enum": ["ephemeral", "stateful", "managed", "self_hosted"] },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isolation", "base_image_or_runtime", "privileged"],
      "properties": {
        "isolation": { "enum": ["process", "container", "virtual_machine", "provider_managed"] },
        "base_image_or_runtime": { "type": "string", "minLength": 1 },
        "privileged": { "const": false }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_policy", "allowed_destinations"],
      "properties": {
        "default_policy": { "const": "deny" },
        "allowed_destinations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_scopes", "write_scopes", "persistent_scopes"],
      "properties": {
        "read_scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "write_scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "persistent_scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "integrity"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "integrity": { "type": "string", "minLength": 1 }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "allowed_refs", "injection", "repository_storage"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "allowed_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "injection": { "enum": ["runtime_only", "not_allowed"] },
        "repository_storage": { "const": "forbidden" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds", "turns", "tool_calls", "parallel_tasks", "input_tokens", "output_tokens", "cost_amount", "cost_currency"],
      "properties": {
        "duration_seconds": { "type": "integer", "minimum": 1 },
        "turns": { "type": "integer", "minimum": 1 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "parallel_tasks": { "type": "integer", "minimum": 1 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cost_amount": { "type": "number", "minimum": 0 },
        "cost_currency": { "type": "string", "minLength": 1 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistence", "compaction_policy", "session_retention_days"],
      "properties": {
        "persistence": { "enum": ["none", "session", "approved_store"] },
        "compaction_policy": { "type": "string", "minLength": 1 },
        "session_retention_days": { "type": "integer", "minimum": 0 }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_level", "storage_ref", "retention_days", "redaction_policy"],
      "properties": {
        "trace_level": { "enum": ["metadata", "redacted", "full_approved"] },
        "storage_ref": { "type": "string", "minLength": 1 },
        "retention_days": { "type": "integer", "minimum": 0 },
        "redaction_policy": { "type": "string", "minLength": 1 }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_classifications", "residency", "training_use"],
      "properties": {
        "allowed_classifications": { "type": "array", "minItems": 1, "items": { "enum": ["public", "internal", "confidential", "restricted"] }, "uniqueItems": true },
        "residency": { "type": "string", "minLength": 1 },
        "training_use": { "enum": ["forbidden", "contract_controlled"] }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_mode", "evidence_log", "expiry_required"],
      "properties": {
        "failure_mode": { "const": "fail_closed" },
        "evidence_log": { "type": "string", "minLength": 1 },
        "expiry_required": { "type": "boolean" }
      }
    }
  }
}
